 257              	#----------------------------------------------------------------------
 258              	
 259              	
 260              	# Moore says the 22 deep are infinite :)
 261              	# aeForth use round-robin stacks of 32 deep, (or chose a 2^N)
 262              	# the stack must start at a multiple of it
 263              	# and magics by == NOT(DEEP*CELL)
 264              	# 32 * 4 is 128 as 0b10000000
 265              	
 266              	
 267              	# moves backwards
 268              	
 269              	.equ stacks, 32
 270              	
 271              	# data stack
 272              	
 273              	.equ sp_size, stacks * CELL
 274              	
 275              	# return stack
 276              	
 277              	.equ rp_size, stacks * CELL
 278              	
 279              	.equ stack_deep, (0xFFFFFFBF)
 280              	
 281              	.ifdef stack_macros
 282              	
 283              	# round robin hack mask bit for 128 bit, 32 * CELL
 284              	
 285              	
GAS LISTING /tmp/ccSg6qBb.s 			page 6


 286              	# generic push into memory
 287              	.macro push rg ps
 288              	        addi \ps, \ps, -1 * CELL
 289              	        # round robin hack
 290              	        andi \ps, \ps, stack_deep
 291              	        sw \rg, 0 (\ps)
 292              	.endm
 293              	
 294              	# generic pull from memory
 295              	.macro pull rg ps
 296              	        lw \rg, 0 (\ps)
 297              	        addi \ps, \ps, +1 * CELL
 298              	        # round robin hack
 299              	        andi \ps, \ps, stack_deep
 300              	.endm
 301              	
 302              	.endif
