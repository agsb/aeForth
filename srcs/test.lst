 172              	
 173              	#----------------------------------------------------------------------
 174              	
 175              	
 176              	# Moore says the 22 deep are infinite :)
 177              	# use round-robin stacks of 32 deep, or 2^n
 178              	# the stack must start at a multiple of it as 1*10000000
 179              	# magics by -1 * 32 * CELL == NOT(32*CELL)
 180              	
 181              	.equ stack_deep, (-1 * stacks * CELL)
 182              	
 183              	# generic push into memory
 184              	.macro push rg ps
 185              	        addi \ps, \ps, -1 * CELL
 186              	        andi \ps, \ps, stack_deep
 187              	        sw \rg, 0 (\ps)
 188              	.endm
 189              	
 190              	# generic pull from memory
 191              	.macro pull rg ps
 192              	        lw \rg, 0 (\ps)
 193              	        addi \ps, \ps, +1 * CELL
 194              	        andi \ps, \ps, stack_deep
 195              	.endm
