 153              	#----------------------------------------------------------------------
 154              	
 155              	# label 9999 must be exclusive :)
 156              	# ht_ header, with link and hash
 157              	# xt_ native code or list of references
 158              	
 159              	.macro def_word label:req hash:req flag=0x0
 160              	ht_\label:
 161              	    .word 9999b - 8
 162              	    .word (\hash | \flag)
 163              	9999:
 164              	xt_\label:
 165              	.endm
 166              	
 167              	# gcc handles big long jumps by relaxation :)
 168              	
 169              	.macro end_word
 170              	    j next
 171              	.endm
