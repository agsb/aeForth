 190              	
 191              	#----------------------------------------------------------------------
 192              	
 193              	
 194              	# Moore says the 22 deep are infinite :)
 195              	# use round-robin stacks of 32 deep, or 2^n
 196              	# the stack must start at a multiple of it as 1*10000000
 197              	# magics by -1 * 32 * CELL == NOT(32*CELL)
 198              	
 199              	
 200              	.equ stacks, 32
 201              	
 202              	# data stack
 203              	
 204              	.equ sp_size, stacks * CELL
 205              	
 206              	# return stack
 207              	
 208              	.equ rp_size, stacks * CELL
 209              	
 210              	# moves backwards
 211              	
 212              	.equ stack_deep, (-1 * stacks * CELL)
 213              	
 214              	# generic push into memory
 215              	.macro push rg ps
 216              	        addi \ps, \ps, -1 * CELL
 217              	        andi \ps, \ps, stack_deep
 218              	        sw \rg, 0 (\ps)
 219              	.endm
 220              	
 221              	# generic pull from memory
 222              	.macro pull rg ps
 223              	        lw \rg, 0 (\ps)
 224              	        addi \ps, \ps, +1 * CELL
 225              	        andi \ps, \ps, stack_deep
 226              	.endm
 227              	
 228              	#----------------------------------------------------------------------
