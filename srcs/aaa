
# generic push into memory
.macro push rg ps 
        addi \ps, \ps, -1 * CELL
        # round robin hack
        andi \ps, \ps, stack_deep
        sw \rg, 0 (\ps)
.endm

# generic pull from memory
.macro pull rg ps
        lw \rg, 0 (\ps)
        addi \ps, \ps, +1 * CELL
        # round robin hack
        andi \ps, \ps, stack_deep
.endm

