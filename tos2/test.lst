 124              	
 125              	# label 9999 must be exclusive :)
 126              	# ht_ header, with link and hash
 127              	# xt_ native code or list of references
 128              	
 129              	.macro def_word label hash
 130              	ht_\label:
 131              	    .word 9999b - 8
 132              	    .word \hash
 133              	9999:
 134              	xt_\label:
 135              	.endm
 136              	
 137              	# gcc handles big long jumps by relaxation :)
 138              	.macro end_native
 139              	    j next
 140              	.endm
 141              	
 142              	# generic push into memory
 143              	.macro push rg ps
 144              	  addi \ps, \ps, -1 * CELL
 145              	 sw \rg, 0 (\ps)
 146              	.endm
 147              	
 148              	# generic pull from memory
 149              	.macro pull rg ps
 150              	 lw \rg, 0 (\ps)
 151              	  addi \ps, \ps, 1 * CELL
 152              	.endm
