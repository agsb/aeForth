
VARIABLE CONTEXT

VARIABLE CURRENT

VARIABLE CURRENT-WIP

CREATE SEARCH-ORDER 16 CELLS ALLOT

: DEFINITIONS CONTEXT @ CURRENT ! ;

: WORDLIST ALIGN HERE 0 , ;

: GET-CURRENT CURRENT-WIP @ ;

: SET-CURRENT CURRENT-WIP ! ;

\ -------------------------------

VARIABLE #ORDER

: GET-ORDER 
	#ORDER @ ?DO
	SEARCH-ORDER #ORDER @ I - 1- CELLS + @ LOOP #ORDER @
	;

: SET-ORDER 
	DUP -1 = IF DROP FORTH-WORDLIST 1 THEN 
	DUP #ORDER !
	0 ?DO SEARCH-ORDER I CELLS + ! LOOP 
	;

: VOCABULARY
	CREATE 0 , DOES> CONTEXT ! ;

: ONLY -1 SET-ORDER ;

: ALSO GET-ORDER OVER SWAP 1+ SET-ORDER ;

: PREVIOUS GET_ORDER NIP 1- SET_ORDER ;

/ ---------------------------------------------------------------------

CREATE ORDER-STACK 16 CELLS ALLOT

ORDER-STACK VALUE CONTEXT

: SET-ORDER

	DUP -1 = IF DROP FORTH-WORDLIST 1 THEN
	DUP 16 > IF -49 THROW THEN
	DUP  0 < IF -50 THROW THEN

	ORDER-STACK TO CONTEXT
	0 ?DO CONTEXT CELL+ TO CONTEXT CONTEXT ! LOOP 
	;

: GET-ORDER
	CONTEXT ORDER-STACK - 1 CELLS DUP 
	>R 0 ?DO ORDER-STACK I 1+ CELLS + @ LOOP >R
	;

