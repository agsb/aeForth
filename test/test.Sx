
999:
	.word 0x0

.macro def_native name label hash 
it_\label:
        .align 2
	.word 999b - 8
        .word \hash
999:
is_\label:
	.word \hash
.endm

.equ my_hash0, 0x0

.equ my_hash1, 0x1

.equ my_hash2, 0x2

.equ my_hash3, 0x3

.equ my_hash4, 0x4

.equ my_hash5, 0x5

.equ my_hash6, 0x6

.equ my_hash7, 0x7

.equ my_hash8, 0x8

.equ my_hash9, 0x9

_start:

	nop
	nop
	nop
	nop

def_native "NAME0" "my_label0" my_hash0

def_native "NAME1" "my_label1" my_hash1

def_native "NAME2" "my_label2" my_hash2

def_native "NAME3" "my_label3" my_hash3

def_native "NAME4" "my_label4" my_hash4

def_native "NAME7" "my_label7" my_hash7

def_native "NAME6" "my_label6" my_hash6

def_native "NAME5" "my_label5" my_hash5

def_native "NAME8" "my_label8" my_hash8

def_native "NAME9" "my_label9" my_hash9




